# =============================================
#   Metro Memory — Environment Variables
# =============================================
# Copy this file to .env and fill in the values.
# Never commit your real .env file to version control.

# ----------------------------
# Server
# ----------------------------

# Port the HTTP server listens on
PORT=3000

# Public base URL used in email links (e.g. password reset)
# BASE_URL=https://your-domain.com

# ----------------------------
# Security (REQUIRED in production)
# ----------------------------

# Secret used to sign session cookies.
# Generate a strong value: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# ----------------------------
# Database
# ----------------------------

# Database engine: "sqlite" (default) or "mysql"
MEMORY_DB_TYPE=sqlite

# SQLite — path to the database file (relative to project root)
SQLITE_FILENAME=database.sqlite

# MySQL — only needed when MEMORY_DB_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=db_user
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=memory_db

# ----------------------------
# Email (optional — only needed for password-reset emails)
# ----------------------------

# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=user@example.com
# MAIL_PASSWORD=yourpassword
# MAIL_FROM="Metro Memory" <noreply@example.com>

# ----------------------------
# First admin account (created automatically on first run)
# ----------------------------

FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123
FIRST_ADMIN_EMAIL=admin@memory.local
