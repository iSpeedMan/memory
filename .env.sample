# =============================================
#   Metro Memory — Environment Variables
# =============================================
# Copy this file to .env and fill in the values.
# Never commit your real .env file to version control.

# ----------------------------
# Server
# ----------------------------

# Port the HTTP server listens on (default: 5000)
PORT=5000

# Public base URL used in email links (e.g. password reset).
# Required if you send emails. Include scheme, no trailing slash.
# BASE_URL=https://your-domain.com

# Runtime environment. Set to "production" for live deployments.
# Effects: disables dev error details in responses, enables secure cookies,
# activates strict Content Security Policy, enables HTTP/S-only redirects.
# Values: "development" | "production"
NODE_ENV=development

# ----------------------------
# Security (REQUIRED in production)
# ----------------------------

# Secret used to sign session cookies.
# Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In production this MUST be changed from the default.
SESSION_SECRET=replace_with_a_long_random_string

# Restrict access to the Swagger API docs (/api/docs) by IP address.
# Comma-separated list of allowed IPs. Empty = open to all. Use * to explicitly allow all.
# Example: SWAGGER_ALLOWED_IPS=127.0.0.1,::1,10.0.0.5
# SWAGGER_ALLOWED_IPS=

# Number of bcrypt rounds used when hashing passwords.
# Higher = slower login but safer. 10 is a good default; 12–14 for high-security.
# Changing this only affects newly created passwords.
BCRYPT_ROUNDS=10

# ----------------------------
# Database
# ----------------------------

# Database engine to use.
# Values: "sqlite" (default, zero-config) | "mysql" (for production scale)
MEMORY_DB_TYPE=sqlite

# SQLite — path to the database file, relative to project root.
# Only used when MEMORY_DB_TYPE=sqlite.
SQLITE_FILENAME=database.sqlite

# MySQL — only required when MEMORY_DB_TYPE=mysql.
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=db_user
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=memory_db

# ----------------------------
# Redis (optional)
# ----------------------------

# Redis connection URL. When not set, the server falls back to in-memory
# stores (sessions, rate-limit counters). Redis is recommended in production
# so sessions survive restarts and work across multiple processes.
# Format: redis://[user:password@]host:port/db
# REDIS_URL=redis://127.0.0.1:6379/0

# ----------------------------
# Email (optional)
# ----------------------------
# Required only if you want password-reset emails to work.
# If not configured, password reset will silently fail.

# SMTP server hostname
# MAIL_HOST=smtp.example.com

# SMTP port (587 for STARTTLS, 465 for SSL, 25 for plain)
# MAIL_PORT=587

# Use TLS from the start (true for port 465, false for 587 + STARTTLS)
# MAIL_SECURE=false

# SMTP credentials
# MAIL_USER=user@example.com
# MAIL_PASSWORD=yourpassword

# "From" header shown to recipients
# MAIL_FROM="Metro Memory" <noreply@example.com>

# ----------------------------
# Localisation
# ----------------------------

# Primary language for server-side logs and error messages.
# This is the fallback language when no user session language is available.
# Values: "en" (default) | "ru"
APP_LANG=en

# ----------------------------
# Logging
# ----------------------------

# Minimum log level written to stdout (uses pino levels).
# Values: "trace" | "debug" | "info" | "warn" | "error" | "fatal"
# Default: "info" in production, "debug" in development.
# LOG_LEVEL=info

# ----------------------------
# First admin account
# ----------------------------
# Created automatically on the very first server start if no admin exists.
# Change these before first run — especially the password.

FIRST_ADMIN_USERNAME=admin
# WARNING: change this before deploying! Must be at least 8 characters.
FIRST_ADMIN_PASSWORD=change_me_before_deploy
FIRST_ADMIN_EMAIL=admin@memory.local
